-- AUTO ĐÁNH SIÊU NHANH (Fast Attack)
-- ============================================================
local fastAttackEnabled = false
local fastAttackConnection = nil
local fastAttackDelay = 0.01 -- Tốc độ đánh (giây)

local function FastAttack()
    if fastAttackConnection then
        fastAttackConnection:Disconnect()
        fastAttackConnection = nil
    end
    
    if not fastAttackEnabled then return end
    
    fastAttackConnection = RunService.Heartbeat:Connect(function()
        if not fastAttackEnabled then return end
        
        local character = LocalPlayer.Character
        if not character then return end
        
        local tool = character:FindFirstChildOfClass("Tool")
        if tool then
            -- Kích hoạt tool liên tục để đánh siêu nhanh
            tool:Activate()
        end
    end)
end

