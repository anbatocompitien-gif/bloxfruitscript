-- ============================================================
-- AUTO NHẶT TRÁI (Auto Collect Fruit)
-- ============================================================
local autoCollectFruitEnabled = false
local autoCollectFruitConnection = nil

local function AutoCollectFruit()
    if autoCollectFruitConnection then
        autoCollectFruitConnection:Disconnect()
        autoCollectFruitConnection = nil
    end
    
    if not autoCollectFruitEnabled then return end
    
    autoCollectFruitConnection = RunService.Heartbeat:Connect(function()
        if not autoCollectFruitEnabled then return end
        
        local character = LocalPlayer.Character
        if not character then return end
        
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if not rootPart then return end
        
        -- Quét tất cả trái cây trong Workspace
        for _, fruit in pairs(Workspace:GetChildren()) do
            -- Kiểm tra tên có chứa "Fruit" hoặc "Devil Fruit"
            if fruit.Name:find("Fruit") or fruit.Name:find("Devil") then
                if fruit:FindFirstChild("Handle") then
                    local fruitPos = fruit.Handle.Position
                    local distance = (rootPart.Position - fruitPos).Magnitude
                    
                    -- Nếu trong phạm vi 500 studs thì tele đến nhặt
                    if distance < 500 then
                        rootPart.CFrame = CFrame.new(fruitPos + Vector3.new(0, 3, 0))
                        wait(0.1)
                    end
                end
            end
        end
    end)
end

